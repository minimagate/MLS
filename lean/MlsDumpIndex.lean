-- Trusted premise-index extractor for Mathlib premise retrieval (M4).
--
-- Dumps a deterministic, heuristically filtered set of public Mathlib declaration
-- names (theorem, def, inductive, constructor, axiom, opaque) with kind, module,
-- instance and deprecation flags,
-- docstring (or null) and the `ppExpr` pretty-printed type, as JSON Lines sorted
-- by declaration name. Intended to be deterministic for a fixed Mathlib commit.
--
-- Filter version: 1. Extractor version: this file's sha256 (recorded in manifest).
--
-- Run from the MLS repository root (the `.mls` project is already built):
--   cd .mls && \
--   PATH="$PWD/../.toolchains/lean-4.19.0-darwin_aarch64/bin:$PATH" \
--   MATHLIB_CACHE_DIR="$PWD/../.toolchains/mathlib-cache" \
--   MLS_INDEX_OUT="$PWD/../.mls/index/mathlib-<commit>/premises.jsonl" \
--   lake env lean "$PWD/../lean/MlsDumpIndex.lean"
--
-- MLS_INDEX_OUT is required; the output directory must exist. Progress and counts go
-- to stderr. Takes about 5 minutes on Apple Silicon. Not part of any Lake library.
import Mathlib
import Lean

/-!
Versioned extractor for a premise-retrieval index from the already-imported pinned
environment. The auxiliary-component blacklist is deliberately lossy and can exclude
rare public mathematical names such as `NONote.below`; the manifest records its filter
version so changing that tradeoff invalidates the index.

Run from the `.mls` Lake project with `lake env lean <this file>` and
`MLS_INDEX_OUT=<path>` set. Output is sorted by declaration name so that the
file is byte-identical for identical inputs.
-/

open Lean Meta Elab Command

namespace MlsDumpIndex

def isDigits (s : String) : Bool := !s.isEmpty && s.all Char.isDigit

/-- Components excluded by the version-1 auxiliary-name heuristic. -/
def isAuxComponent (s : String) : Bool :=
  s.startsWith "_" ||
  (["match_", "proof_", "eq_"].any fun p => s.startsWith p && isDigits (s.drop p.length)) ||
  ["eq_def", "sizeOf_spec", "casesOn", "recOn", "brecOn", "binductionOn", "below",
    "ibelow", "noConfusion", "noConfusionType"].contains s

def nameComps : Name → List (Option String)
  | .anonymous => []
  | .str p s => some s :: nameComps p
  | .num p _ => none :: nameComps p

def hasAuxComponent (n : Name) : Bool :=
  (nameComps n).any fun
    | none => true
    | some s => isAuxComponent s

def kindOf : ConstantInfo → Option String
  | .thmInfo _ => some "theorem"
  | .defnInfo _ => some "def"
  | .inductInfo _ => some "inductive"
  | .ctorInfo _ => some "constructor"
  | .axiomInfo _ => some "axiom"
  | .opaqueInfo _ => some "opaque"
  | _ => none

structure Stats where
  total : Nat := 0
  notMathlib : Nat := 0
  auxOrPrivate : Nat := 0
  autoGenerated : Nat := 0
  badKind : Nat := 0
  kept : Nat := 0
  keptWithDoc : Nat := 0
  keptInstance : Nat := 0
  keptDeprecated : Nat := 0

end MlsDumpIndex

open MlsDumpIndex in
elab "#mls_dump_index" : command => do
  let some outPath ← IO.getEnv "MLS_INDEX_OUT" | throwError "MLS_INDEX_OUT is not set"
  let env ← getEnv
  let entries := env.constants.map₁.toList
  let t0 ← IO.monoMsNow
  let (rows, stats) ← liftTermElabM do
    let mut stats : Stats := { total := entries.length }
    let mut rows : Array (String × String) := #[]
    for (n, ci) in entries do
      let some idx := env.getModuleIdxFor? n | continue
      let modName := env.header.moduleNames[idx.toNat]!
      if modName.getRoot != `Mathlib then
        stats := { stats with notMathlib := stats.notMathlib + 1 }
        continue
      if isPrivateName n || hasAuxComponent n then
        stats := { stats with auxOrPrivate := stats.auxOrPrivate + 1 }
        continue
      if isAuxRecursor env n || isNoConfusion env n || isMatcherCore env n then
        stats := { stats with autoGenerated := stats.autoGenerated + 1 }
        continue
      let some kind := kindOf ci | do
        stats := { stats with badKind := stats.badKind + 1 }
        continue
      let doc ← findDocString? env n
      let isInst := isInstanceCore env n
      let deprecated := Linter.isDeprecated env n
      let ty ← ppExpr ci.type
      let json := Lean.Json.mkObj [
        ("name", Lean.toJson n.toString),
        ("kind", Lean.toJson kind),
        ("module", Lean.toJson modName.toString),
        ("instance", Lean.toJson isInst),
        ("deprecated", Lean.toJson deprecated),
        ("doc", match doc with | some d => Lean.toJson d | none => Lean.Json.null),
        ("type", Lean.toJson ty.pretty)]
      rows := rows.push (n.toString, json.compress)
      stats := { stats with kept := stats.kept + 1 }
      if doc.isSome then stats := { stats with keptWithDoc := stats.keptWithDoc + 1 }
      if isInst then stats := { stats with keptInstance := stats.keptInstance + 1 }
      if deprecated then stats := { stats with keptDeprecated := stats.keptDeprecated + 1 }
    return (rows, stats)
  let sorted := rows.qsort (fun a b => a.1 < b.1)
  let h ← IO.FS.Handle.mk outPath .write
  for (_, line) in sorted do
    h.putStrLn line
  h.flush
  let t1 ← IO.monoMsNow
  IO.eprintln s!"constants={stats.total} notMathlib={stats.notMathlib} auxOrPrivate={stats.auxOrPrivate} autoGenerated={stats.autoGenerated} badKind={stats.badKind} kept={stats.kept} withDoc={stats.keptWithDoc} instances={stats.keptInstance} deprecated={stats.keptDeprecated} elapsedMs={t1 - t0}"

#mls_dump_index
