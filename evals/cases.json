        "label": "thm:triangle",
        "variables": [
          {
            "name": "x",
            "type": "real"
          },
          {
            "name": "y",
            "type": "real"
          }
        ],
        "hypotheses": [],
        "conclusion": "|x + y| ≤ |x| + |y|",
        "uses": [],
        "assumptions_made": []
      }
    },
    {
      "id": "maximum",
      "block_id": "f3501b9a-354d-5e8e-a7b2-d4506acafaa7",
      "area": "analysis",
      "source_text": "Suppose a ≤ b are real and f : ℝ → ℝ is continuous on [a,b]. Some c in [a,b] maximizes f over that interval.",
      "provenance": {
        "kind": "paraphrased_specialization",
        "url": "https://www.jirka.org/ra/html/sec_minmaxint.html",
        "reference": "Jiří Lebl, Basic Analysis I, §3.3"
      },
      "expected_sir": {
        "kind": "theorem",
        "label": "thm:maximum",
        "variables": [
          {
            "name": "f",
            "type": "function ℝ → ℝ"
          },
          {
            "name": "a",
            "type": "real"
          },
          {
            "name": "b",
            "type": "real"
          }
        ],
        "hypotheses": [
          "a ≤ b",
          "f is continuous on [a, b]"
        ],
        "conclusion": "∃ c ∈ [a, b], ∀ x ∈ [a, b], f x ≤ f c",
        "uses": [],
        "assumptions_made": []
      }
    },
    {
      "id": "intermediate",
      "block_id": "4a8a6714-0853-5ffa-9998-5fcec17e963b",
      "area": "analysis",
      "source_text": "Let real a ≤ b and y be given. If f : ℝ → ℝ is continuous on [a,b] and f(a) ≤ y ≤ f(b), then f(c)=y for some c in [a,b].",
      "provenance": {
        "kind": "paraphrased_specialization",
        "url": "https://www.jirka.org/ra/html/sec_minmaxint.html",
        "reference": "Jiří Lebl, Basic Analysis I, §3.3"
      },
      "expected_sir": {
        "kind": "theorem",
        "label": "thm:intermediate",
        "variables": [
          {
            "name": "f",
            "type": "function ℝ → ℝ"
          },
          {
            "name": "a",
            "type": "real"
          },
          {
            "name": "b",
            "type": "real"
          },
          {
            "name": "y",
            "type": "real"
          }
        ],
        "hypotheses": [
          "a ≤ b",
          "f is continuous on [a, b]",
          "f a ≤ y",
          "y ≤ f b"
        ],
        "conclusion": "∃ c ∈ [a, b], f c = y",
        "uses": [],
        "assumptions_made": []
      }
    },
    {
