    {
      "id": "bounded-on",
      "block_id": "b94dd474-4475-5914-bf73-301208211377",
      "area": "analysis",
      "source_text": "For f : ℝ → ℝ and D ⊆ ℝ, boundedness on D means that some real M satisfies |f(x)| ≤ M for every x in D.",
      "provenance": {
        "kind": "paraphrased_specialization",
        "url": "https://www.jirka.org/ra/html/sec_absval.html",
        "reference": "Jiří Lebl, Basic Analysis I, §1.3"
      },
      "expected_sir": {
        "kind": "definition",
        "label": "def:bounded-on",
        "variables": [
          {
            "name": "f",
            "type": "function ℝ → ℝ"
          },
          {
            "name": "D",
            "type": "set of real numbers"
          }
        ],
        "hypotheses": [],
        "conclusion": "∃ M ∈ ℝ, ∀ x ∈ D, |f x| ≤ M",
        "uses": [],
        "assumptions_made": []
      }
    },
    {
