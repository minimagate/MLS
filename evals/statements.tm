<TeXmacs|2.1.5>

<style|generic>

<\body>

<with|mls-id|21f47c55-9702-5949-8cae-735eef142bc6|<section|Analysis>>

<\with|mls-id|b94dd474-4475-5914-bf73-301208211377>
<\definition>
<label|def:bounded-on>For f : <bbb-R> <rightarrow> <bbb-R> and D <subseteq> <bbb-R>, boundedness on D means that some real M satisfies \|f(x)\| <leq> M for every x in D.
</definition>
</with>

<\with|mls-id|12b8a5c9-8ede-5e8c-9f31-70822cd8fb1d>
<\theorem>
<label|thm:triangle>Given real x and y, the magnitude of x+y does not exceed \|x\|+\|y\|.
</theorem>
</with>

<\with|mls-id|f3501b9a-354d-5e8e-a7b2-d4506acafaa7>
<\theorem>
<label|thm:maximum>Suppose a <leq> b are real and f : <bbb-R> <rightarrow> <bbb-R> is continuous on [a,b]. Some c in [a,b] maximizes f over that interval.
</theorem>
</with>

<\with|mls-id|4a8a6714-0853-5ffa-9998-5fcec17e963b>
<\theorem>
<label|thm:intermediate>Let real a <leq> b and y be given. If f : <bbb-R> <rightarrow> <bbb-R> is continuous on [a,b] and f(a) <leq> y <leq> f(b), then f(c)=y for some c in [a,b].
</theorem>
</with>

<\with|mls-id|ba0de2a8-6130-5a15-b61d-e05f8e8b2f8e>
<\theorem>
<label|thm:convergent-bounded>A real sequence u indexed by natural numbers starting at zero, converging to a real L, has a common absolute bound for all its terms.
</theorem>
</with>

<\with|mls-id|e6f78369-4be2-5016-b15e-54de1493a91c>
<\theorem>
<label|thm:monotone-lower>If u : <bbb-N> <rightarrow> <bbb-R> is nondecreasing, then u(0) <leq> u(n) for every natural number n.
</theorem>
</with>

<with|mls-id|45485165-0c9e-585e-bf1d-77ce0dfe0511|<section|Linear Algebra>>

<\with|mls-id|ac157e1b-2b1e-54c7-b3e8-966f150068dd>
<\theorem>
<label|thm:linear-zero>An <bbb-R>-linear map T from <bbb-R><rsup|2> to <bbb-R><rsup|2> sends the zero vector to zero.
</theorem>
</with>

<\with|mls-id|3ce094f7-a825-55af-978b-dec611ca1755>
<\definition>
<label|def:kernel>For an <bbb-R>-linear map T : <bbb-R><rsup|2> <rightarrow> <bbb-R><rsup|2>, define its kernel to consist of the vectors v satisfying T(v)=0.
</definition>
</with>

<\with|mls-id|3ee423c9-ecfd-5cd9-ba12-9ffa99b1eba3>
<\theorem>
<label|thm:kernel-add>Let T : <bbb-R><rsup|2> <rightarrow> <bbb-R><rsup|2> be <bbb-R>-linear. If T(u)=0 and T(v)=0, then T(u+v)=0.
</theorem>
</with>

<with|mls-id|a49636ae-f5c6-5f40-bd78-dc3e6e0bf9e7|<section|Analysis>>

<\with|mls-id|4e59b93f-757c-5b3d-840b-de80ff7e8df3>
<\theorem>
<label|thm:square-nonnegative>For each real number x, its square is nonnegative.
</theorem>
</with>

</body>
