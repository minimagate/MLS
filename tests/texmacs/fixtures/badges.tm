<TeXmacs|2.1.5>

<style|generic>

<\body>
  <\with|mls-id|9f0c1a2e-3b4d-4c5e-8f60-718293a4b5c6>
    <section|Completeness of the reals>
  </with>

  <\with|mls-id|520997b8-c353-44cb-bba8-5e69745c0656>
    <\definition>
      A sequence <math|<around*|(|a<rsub|n>|)>> of real numbers is
      <em|Cauchy> if for every <math|\<varepsilon\>\<gtr\>0> there is
      <math|N> such that <math|<around*|\||a<rsub|m>-a<rsub|n>|\|>\<less\>\<varepsilon\>>
      for all <math|m,n\<geqslant\>N>.<label|def:cauchy>
    </definition>
  </with>

  <\with|mls-id|e3220339-8782-4a00-8952-345d0005ab01>
    <\lemma>
      Every Cauchy sequence is bounded.<label|lem:bounded>
    </lemma>
  </with>

  <\with|mls-id|e688a3ab-4e5d-4b7e-9c57-c857a7e07741>
    <\theorem>
      Every convergent sequence of real numbers is Cauchy.<label|thm:conv-cauchy>
    </theorem>
  </with>

  <\with|mls-id|7a8ae695-2a47-4e3d-b5cb-664566c24911>
    <\theorem>
      Every Cauchy sequence of real numbers converges.<label|thm:cauchy-conv>
    </theorem>
  </with>

  <\with|mls-id|20126ddc-bfe5-4ff3-a604-a8cf7a75f411>
    <\corollary>
      The real numbers are complete.<label|cor:complete>
    </corollary>
  </with>

  <\with|mls-id|2aefa595-4494-4a0f-9be1-eb81b12b7f0a>
    <\proposition>
      Every bounded sequence of real numbers converges.<label|prop:bounded-conv>
    </proposition>
  </with>

  <\with|mls-id|37206045-447a-4559-8d22-dde83d5d212d>
    <\proposition>
      A monotone bounded sequence of real numbers converges.<label|prop:monotone>
    </proposition>
  </with>

  <\with|mls-id|d6f2ab0b-d1b2-489d-8e75-6dfe3ee9bd70>
    <\lemma>
      Every sequence of real numbers has a monotone subsequence.<label|lem:monotone-sub>
    </lemma>
  </with>
</body>

<\initial>
  <\collection>
    <associate|page-medium|paper>
  </collection>
</initial>
