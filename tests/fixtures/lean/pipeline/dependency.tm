<\body>
  <section|Definition>
  <\with|mls-id|00000000-0000-4000-8000-000000000007><\definition>The identity function on natural numbers maps x to x.<label|def:identity></definition></with>
  <section|Theorem>
  <\with|mls-id|00000000-0000-4000-8000-000000000008><\theorem>The identity function maps zero to zero by <reference|def:identity>.<label|thm:identity-zero></theorem></with>
