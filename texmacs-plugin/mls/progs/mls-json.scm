;;; mls-json.scm -- pure JSON reader and writer for the MLS plugin.
;;;
;;; Reader: objects become alists of (key . value), arrays become vectors,
;;; null becomes the symbol null, true and false become #t and #f. Trailing
;;; data and malformed input signal an error. Engine output is parsed here as
;;; data and never evaluated.
;;; Writer: the same shapes back (an alist is an object, a vector an array).

(define (mls-json-parse text)
  "Parse the JSON document TEXT into the shapes described above."
  (let ((n (string-length text))
        (pos 0))
    (define (peek) (if (< pos n) (string-ref text pos) #\nul))
    (define (advance!) (set! pos (+ pos 1)))
    (define (fail what)
      (error (string-append "json: " what " at offset " (number->string pos))))
    (define (expect! c)
      (if (char=? (peek) c) (advance!) (fail (string-append "expected " (string c)))))
    (define (skip-space!)
      (let loop ()
        (when (and (< pos n) (memv (peek) '(#\space #\tab #\newline #\return)))
          (advance!)
          (loop))))
    (define (literal! word value)
      (let ((end (+ pos (string-length word))))
        (if (and (<= end n) (string=? (substring text pos end) word))
            (begin (set! pos end) value)
            (fail "bad literal"))))
    (define (hex-value c)
      (cond ((and (char>=? c #\0) (char<=? c #\9)) (- (char->integer c) 48))
            ((and (char>=? c #\a) (char<=? c #\f)) (- (char->integer c) 87))
            ((and (char>=? c #\A) (char<=? c #\F)) (- (char->integer c) 55))
            (else #f)))
    (define (try-hex4)
      "Value of the next four hex digits, or #f (the position moves only on success)."
      (let loop ((i 0) (v 0) (p pos))
        (if (= i 4)
            (begin (set! pos p) v)
            (let ((d (and (< p n) (hex-value (string-ref text p)))))
              (and d (loop (+ i 1) (+ (* v 16) d) (+ p 1)))))))
    (define (read-hex4!)
      (or (try-hex4) (fail "bad unicode escape")))
    (define (low-surrogate-follows)
      "If the next escape is a low surrogate \\uDC00-\\uDFFF, consume it and return its value, else #f."
      (and (< (+ pos 1) n)
           (char=? (string-ref text pos) #\\)
           (char=? (string-ref text (+ pos 1)) #\u)
           (let ((save pos))
             (set! pos (+ pos 2))
             (let ((lo (try-hex4)))
               (if (and lo (>= lo #xDC00) (<= lo #xDFFF))
                   lo
                   (begin (set! pos save) #f))))))
    (define (read-codepoint!)
      "The code point of a \\u escape. Lone or invalid surrogates become U+FFFD;
the escape that follows an unpaired high surrogate is left for the caller."
      (let ((hi (read-hex4!)))
        (cond ((and (>= hi #xDC00) (<= hi #xDFFF)) #xFFFD)
              ((and (>= hi #xD800) (<= hi #xDBFF))
               (let ((lo (low-surrogate-follows)))
                 (if lo
                     (+ #x10000 (* (- hi #xD800) #x400) (- lo #xDC00))
                     #xFFFD)))
              (else hi))))
    (define (utf8-chars cp)
      (define (byte k) (integer->char k))
      (cond ((< cp #x80) (list (byte cp)))
            ((< cp #x800)
             (list (byte (+ #xC0 (quotient cp 64)))
                   (byte (+ #x80 (remainder cp 64)))))
            ((< cp #x10000)
             (list (byte (+ #xE0 (quotient cp 4096)))
                   (byte (+ #x80 (remainder (quotient cp 64) 64)))
                   (byte (+ #x80 (remainder cp 64)))))
            (else
             (list (byte (+ #xF0 (quotient cp 262144)))
                   (byte (+ #x80 (remainder (quotient cp 4096) 64)))
                   (byte (+ #x80 (remainder (quotient cp 64) 64)))
                   (byte (+ #x80 (remainder cp 64)))))))
    (define (parse-string)
      (expect! #\")
      (let loop ((acc '()))
        (cond ((>= pos n) (fail "unterminated string"))
              ((char=? (peek) #\")
               (advance!)
               (list->string (reverse acc)))
              ((char=? (peek) #\\)
               (advance!)
               (let ((e (peek)))
                 (advance!)
                 (case e
                   ((#\") (loop (cons #\" acc)))
                   ((#\\) (loop (cons #\\ acc)))
                   ((#\/) (loop (cons #\/ acc)))
                   ((#\b) (loop (cons (integer->char 8) acc)))
                   ((#\f) (loop (cons (integer->char 12) acc)))
                   ((#\n) (loop (cons #\newline acc)))
                   ((#\r) (loop (cons #\return acc)))
                   ((#\t) (loop (cons #\tab acc)))
                   ((#\u) (loop (append (reverse (utf8-chars (read-codepoint!))) acc)))
                   (else (fail "bad escape")))))
              ((< (char->integer (peek)) 32) (fail "control character in string"))
              (else (let ((c (peek)))
                      (advance!)
                      (loop (cons c acc)))))))
    (define (parse-number)
      (let ((start pos))
        (let loop ()
          (when (and (< pos n) (memv (peek) (string->list "+-.eE0123456789")))
            (advance!)
            (loop)))
        (or (string->number (substring text start pos))
            (begin (set! pos start) (fail "bad number")))))
    (define (parse-array)
      (expect! #\[)
      (skip-space!)
      (if (char=? (peek) #\])
          (begin (advance!) (vector))
          (let loop ((acc '()))
            (let ((v (parse-value)))
              (skip-space!)
              (cond ((char=? (peek) #\,) (advance!) (loop (cons v acc)))
                    ((char=? (peek) #\]) (advance!) (list->vector (reverse (cons v acc))))
                    (else (fail "expected , or ]")))))))
    (define (parse-object)
      (expect! #\{)
      (skip-space!)
      (if (char=? (peek) #\})
          (begin (advance!) '())
          (let loop ((acc '()))
            (skip-space!)
            (let ((key (parse-string)))
              (skip-space!)
              (expect! #\:)
              (let ((v (parse-value)))
                (skip-space!)
                (cond ((char=? (peek) #\,) (advance!) (loop (cons (cons key v) acc)))
                      ((char=? (peek) #\}) (advance!) (reverse (cons (cons key v) acc)))
                      (else (fail "expected , or }"))))))))
    (define (parse-value)
      (skip-space!)
      (let ((c (peek)))
        (cond ((char=? c #\{) (parse-object))
              ((char=? c #\[) (parse-array))
              ((char=? c #\") (parse-string))
              ((char=? c #\t) (literal! "true" #t))
              ((char=? c #\f) (literal! "false" #f))
              ((char=? c #\n) (literal! "null" 'null))
              ((or (char=? c #\-) (char-numeric? c)) (parse-number))
              (else (fail "unexpected character")))))
    (let ((v (parse-value)))
      (skip-space!)
      (if (< pos n) (fail "trailing data"))
      v)))

(define (mls-json-get obj key)
  "Value of KEY in the object OBJ, or #f when absent. JSON null reads as the symbol null."
  (and (pair? obj)
       (let ((hit (assoc key obj)))
         (and hit (cdr hit)))))

(define (mls-json-escape-char c)
  (cond ((char=? c #\") "\\\"")
        ((char=? c #\\) "\\\\")
        ((char=? c #\newline) "\\n")
        ((char=? c #\return) "\\r")
        ((char=? c #\tab) "\\t")
        ((< (char->integer c) 32)
         (let ((hex (number->string (char->integer c) 16)))
           (string-append "\\u" (make-string (- 4 (string-length hex)) #\0) hex)))
        (else (string c))))

(define (mls-json-quote s)
  (string-append "\""
                 (apply string-append (map mls-json-escape-char (string->list s)))
                 "\""))

(define (mls-json-encode v)
  "Encode V: #t/#f, 'null, numbers, strings, vectors (arrays) and alists (objects)."
  (cond ((eq? v 'null) "null")
        ((eq? v #t) "true")
        ((eq? v #f) "false")
        ((number? v) (number->string v))
        ((string? v) (mls-json-quote v))
        ((vector? v)
         (string-append "[" (mls-join (map mls-json-encode (vector->list v)) ",") "]"))
        ((list? v)
         (string-append
          "{"
          (mls-join (map (lambda (pair)
                           (string-append (mls-json-quote (car pair)) ":"
                                          (mls-json-encode (cdr pair))))
                         v)
                    ",")
          "}"))
        (else (error "json: cannot encode" v))))
